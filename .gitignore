# Al repositorio solo van estos archivos. Todo lo demás (Instalador, legacy, build_env,
# build, dist, configuración, registros, certificados...) se queda solo en tu PC.
/*
!/.gitignore
!/.gitattributes
!/utilidades_archivos.py
!/compilar.py
!/compilar.bat
!/build_env.bat
!/requirements.txt
!/README.md
!/LICENSE
!/recursos/

# Por si alguna vez se agrega algo a mano: nunca certificados de firma
*.pfx
*.p12
